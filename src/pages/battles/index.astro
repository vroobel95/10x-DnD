---
import Layout from "@/layouts/Layout.astro";
import BattleCard from "@/components/battles/BattleCard.astro";
import { createClient } from "@/lib/supabase";
import type { Battle } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;

let battles: Battle[] = [];

if (supabase && user) {
  const { data: campaign } = await supabase.from("campaigns").select("id").eq("user_id", user.id).limit(1).single();

  if (campaign) {
    const { data } = await supabase
      .from("battles")
      .select("*")
      .eq("campaign_id", campaign.id)
      .order("created_at", { ascending: false });

    battles = (data ?? []) as Battle[];
  }
}
---

<Layout title="My Battles">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-3xl">
      <div class="mb-8 flex items-center justify-between">
        <h1 class="bg-linear-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          My Battles
        </h1>
        <a
          href="/battles/new"
          class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          + New Battle
        </a>
      </div>

      {
        battles.length === 0 ? (
          <div class="rounded-xl border border-white/10 bg-white/5 p-10 text-center backdrop-blur-xl">
            <p class="mb-2 text-lg font-semibold text-white">No battles yet</p>
            <p class="mb-6 text-sm text-blue-100/60">Create your first battle to get started.</p>
            <a
              href="/battles/new"
              class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
            >
              Create your first battle
            </a>
          </div>
        ) : (
          <div class="flex flex-col gap-4">
            {battles.map((battle) => (
              <BattleCard battle={battle} />
            ))}
          </div>
        )
      }

      <form method="POST" action="/api/auth/signout" class="mt-8 text-center">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
