---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import BattleHeader from "@/components/battles/BattleHeader";
import EnemiesSection from "@/components/battles/EnemiesSection";
import EnvironmentSection from "@/components/battles/EnvironmentSection";
import { m } from "@/paraglide/messages.js";
import { getLocale } from "@/paraglide/runtime.js";
import type { Battle, Enemy } from "@/types";

const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;

if (!supabase || !user) {
  return Astro.redirect("/campaigns");
}

const { data: battle, error: battleError } = (await supabase.from("battles").select("*").eq("id", id).single()) as {
  data: Battle | null;
  error: { code: string } | null;
};

if (battleError) {
  if (battleError.code !== "PGRST116") {
    return new Response(null, { status: 500 });
  }
  return Astro.redirect("/campaigns");
}

if (!battle) {
  return Astro.redirect("/campaigns");
}

const b = battle;

const { data: allEnemies } = await supabase
  .from("enemies")
  .select("*")
  .eq("battle_id", b.id)
  .order("created_at", { ascending: true });

const enemies = (allEnemies ?? []) as Enemy[];
const initialPending = enemies.filter((e) => e.status === "pending");
const initialConfirmed = enemies.filter((e) => e.status === "confirmed");

const createdDate = new Date(b.created_at).toLocaleDateString(getLocale(), {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={b.name}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-3xl">
      <a
        href={`/campaigns/${b.campaign_id}`}
        class="mb-6 inline-flex items-center gap-2 text-sm text-blue-100/60 hover:text-white"
      >
        {m.battle_back_to_campaign_arrow()}
      </a>

      <BattleHeader
        battleId={b.id}
        initialName={b.name}
        initialPartyLevel={b.party_level}
        initialLocation={b.location}
        createdDate={createdDate}
        client:load
      />

      <EnvironmentSection battleId={b.id} location={b.location} initialEnvironment={b.environment} client:load />

      <EnemiesSection
        battleId={b.id}
        initialPending={initialPending}
        initialConfirmed={initialConfirmed}
        initialMainEnemyId={b.main_enemy_id}
        initialMainEnemyProfile={b.main_enemy_profile}
        client:load
      />
    </div>
  </div>
</Layout>
