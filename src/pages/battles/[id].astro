---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import EnemiesSection from "@/components/battles/EnemiesSection";
import EnvironmentSection from "@/components/battles/EnvironmentSection";
import type { Battle, Enemy } from "@/types";

const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;

if (!supabase || !user) {
  return Astro.redirect("/campaigns");
}

const { data: battle, error: battleError } = (await supabase.from("battles").select("*").eq("id", id).single()) as {
  data: Battle | null;
  error: { code: string } | null;
};

if (battleError) {
  if (battleError.code !== "PGRST116") {
    return new Response(null, { status: 500 });
  }
  return Astro.redirect("/campaigns");
}

if (!battle) {
  return Astro.redirect("/campaigns");
}

const b = battle;

const { data: allEnemies } = await supabase
  .from("enemies")
  .select("*")
  .eq("battle_id", b.id)
  .order("created_at", { ascending: true });

const enemies = (allEnemies ?? []) as Enemy[];
const initialPending = enemies.filter((e) => e.status === "pending");
const initialConfirmed = enemies.filter((e) => e.status === "confirmed");

const createdDate = new Date(b.created_at).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={b.name}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-3xl">
      <a
        href={`/campaigns/${b.campaign_id}`}
        class="mb-6 inline-flex items-center gap-2 text-sm text-blue-100/60 hover:text-white"
      >
        ← Back to campaign
      </a>

      <h1 class="mb-6 bg-linear-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {b.name}
      </h1>

      <div class="mb-8 flex flex-wrap gap-3">
        {
          b.party_level != null && (
            <span class="rounded-full border border-white/10 bg-white/10 px-3 py-1 text-sm text-blue-100/80">
              Party Level {b.party_level}
            </span>
          )
        }
        {
          b.location && (
            <span class="rounded-full border border-white/10 bg-white/10 px-3 py-1 text-sm text-blue-100/80">
              {b.location}
            </span>
          )
        }
        <span class="rounded-full border border-white/10 bg-white/10 px-3 py-1 text-sm text-blue-100/80">
          Created {createdDate}
        </span>
      </div>

      <EnvironmentSection battleId={b.id} location={b.location} initialEnvironment={b.environment} client:load />

      <EnemiesSection battleId={b.id} initialPending={initialPending} initialConfirmed={initialConfirmed} client:load />
    </div>
  </div>
</Layout>
