---
import Layout from "@/layouts/Layout.astro";
import CreateBattleForm from "@/components/battles/CreateBattleForm";
import { m } from "@/paraglide/messages.js";

const campaignId = Astro.url.searchParams.get("campaignId");

if (!Astro.locals.user) {
  return Astro.redirect("/auth/signin");
}

if (!campaignId) {
  return Astro.redirect(`/campaigns?error=${encodeURIComponent(m.battle_select_campaign_error())}`);
}

const error = Astro.url.searchParams.get("error");
---

<Layout title={m.battle_new_title()}>
  <div class="bg-cosmic flex h-full items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-linear-to-r from-blue-200 to-rose-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        {m.battle_new_title()}
      </h1>
      <CreateBattleForm campaignId={campaignId} serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        <a href={`/campaigns/${campaignId}`} class="text-rose-300 hover:underline">{m.battle_back_to_campaign()}</a>
      </p>
    </div>
  </div>
</Layout>
