---
import Layout from "@/layouts/Layout.astro";
import CreateBattleForm from "@/components/battles/CreateBattleForm";
import Ornament from "@/components/Ornament.astro";
import { m } from "@/paraglide/messages.js";

const campaignId = Astro.url.searchParams.get("campaignId");

if (!Astro.locals.user) {
  return Astro.redirect("/auth/signin");
}

if (!campaignId) {
  return Astro.redirect(`/campaigns?error=${encodeURIComponent(m.battle_select_campaign_error())}`);
}

const error = Astro.url.searchParams.get("error");
---

<Layout title={m.battle_new_title()}>
  <main class="mx-auto max-w-xl px-4 pt-16 pb-20">
    <h1 class="text-ivory font-display text-center text-5xl">{m.battle_new_title()}</h1>

    <Ornament class="my-6" />

    <div class="ink-card p-6 md:p-8">
      <CreateBattleForm campaignId={campaignId} serverError={error} client:load />
    </div>

    <p class="mt-4 text-center text-sm">
      <a href={`/campaigns/${campaignId}`} class="text-blood-bright hover:underline">{m.battle_back_to_campaign()}</a>
    </p>
  </main>
</Layout>
