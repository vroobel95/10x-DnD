---
import Layout from "@/layouts/Layout.astro";
import CampaignBattleList from "@/components/campaigns/CampaignBattleList";
import { createClient } from "@/lib/supabase";
import { m } from "@/paraglide/messages.js";
import type { Battle, Campaign } from "@/types";

const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;

if (!supabase || !user) {
  return Astro.redirect("/auth/signin");
}

const { data: campaign } = (await supabase
  .from("campaigns")
  .select("*")
  .eq("id", id)
  .eq("user_id", user.id)
  .single()) as { data: Campaign | null; error: unknown };

if (!campaign) {
  return Astro.redirect("/campaigns");
}

const { data: battlesData } = await supabase
  .from("battles")
  .select("*")
  .eq("campaign_id", id)
  .order("created_at", { ascending: false });

const battles = (battlesData ?? []) as Battle[];
---

<Layout title={campaign.name}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-3xl">
      <a href="/campaigns" class="mb-6 inline-flex items-center gap-2 text-sm text-blue-100/60 hover:text-white">
        {m.campaign_back_arrow()}
      </a>

      <div class="mb-8 flex items-center justify-between">
        <div>
          <h1 class="bg-linear-to-r from-blue-200 to-rose-200 bg-clip-text text-3xl font-bold text-transparent">
            {campaign.name}
          </h1>
          {campaign.description && <p class="mt-1 text-sm text-blue-100/60">{campaign.description}</p>}
        </div>
        <a
          href={`/battles/new?campaignId=${campaign.id}`}
          class="inline-flex items-center justify-center rounded-lg bg-[#701c3b] px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-[#9f1239]"
        >
          {m.battle_new_title_short()}
        </a>
      </div>

      <CampaignBattleList battles={battles} campaignId={campaign.id} client:load />
    </div>
  </div>
</Layout>
