---
import Layout from "@/layouts/Layout.astro";
import CampaignBattleList from "@/components/campaigns/CampaignBattleList";
import Ornament from "@/components/Ornament.astro";
import { createClient } from "@/lib/supabase";
import { m } from "@/paraglide/messages.js";
import type { Battle, Campaign } from "@/types";

const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;

if (!supabase || !user) {
  return Astro.redirect("/auth/signin");
}

const { data: campaign } = (await supabase
  .from("campaigns")
  .select("*")
  .eq("id", id)
  .eq("user_id", user.id)
  .single()) as { data: Campaign | null; error: unknown };

if (!campaign) {
  return Astro.redirect("/campaigns");
}

const { data: battlesData } = await supabase
  .from("battles")
  .select("*")
  .eq("campaign_id", id)
  .order("created_at", { ascending: false });

const battles = (battlesData ?? []) as Battle[];
---

<Layout title={campaign.name}>
  <main class="mx-auto max-w-4xl px-4 pt-8 pb-20">
    <a href="/campaigns" class="text-blood-bright inline-flex items-center gap-1.5 text-sm hover:underline">
      {m.campaign_back_arrow()}
    </a>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-ivory font-display text-5xl leading-none">{campaign.name}</h1>
        {campaign.description && <p class="text-ivory-dim mt-2 text-sm leading-relaxed">{campaign.description}</p>}
      </div>
      <a
        href={`/battles/new?campaignId=${campaign.id}`}
        class="blood-button inline-flex items-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold"
      >
        {m.battle_new_title_short()}
      </a>
    </div>

    <Ornament class="my-6" />

    <CampaignBattleList battles={battles} campaignId={campaign.id} client:load />
  </main>
</Layout>
