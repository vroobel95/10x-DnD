---
import Layout from "@/layouts/Layout.astro";
import CampaignList from "@/components/campaigns/CampaignList";
import Ornament from "@/components/Ornament.astro";
import { createClient } from "@/lib/supabase";
import { getUserCampaigns } from "@/lib/campaigns";
import { m } from "@/paraglide/messages.js";
import type { CampaignWithCount } from "@/components/campaigns/CampaignList";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;

if (!supabase || !user) {
  return Astro.redirect("/auth/signin");
}

const { data: rawCampaigns, error: campaignsError } = await getUserCampaigns(supabase, user.id);
const campaigns: CampaignWithCount[] = rawCampaigns.map((c: Record<string, unknown>) => ({
  id: c.id as string,
  user_id: c.user_id as string,
  name: c.name as string,
  description: (c.description as string | null) ?? null,
  created_at: c.created_at as string,
  updated_at: c.updated_at as string,
  battleCount: (c.battles as { count: number }[])[0]?.count ?? 0,
}));
---

<Layout title={m.campaigns_title()}>
  <main class="mx-auto max-w-5xl px-4 pt-10 pb-20">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <span class="section-label">{m.campaigns_section_label()}</span>
        <h1 class="text-ivory font-display mt-1 text-5xl">{m.campaigns_title()}</h1>
      </div>
      <a href="/campaigns/new" class="blood-button inline-flex items-center gap-2 rounded-md px-5 py-2.5 font-semibold">
        {m.campaigns_new()}
      </a>
    </div>

    <Ornament class="mb-8" />

    {
      campaignsError && (
        <div class="border-destructive/40 bg-destructive/10 text-destructive mb-4 rounded-md border px-4 py-3 text-sm">
          {m.campaigns_load_error()}
        </div>
      )
    }

    <CampaignList campaigns={campaigns} client:load />
  </main>
</Layout>
