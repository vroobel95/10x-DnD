---
import Layout from "@/layouts/Layout.astro";
import CreateCampaignForm from "@/components/campaigns/CreateCampaignForm";
import Ornament from "@/components/Ornament.astro";
import { m } from "@/paraglide/messages.js";

if (!Astro.locals.user) {
  return Astro.redirect("/auth/signin");
}

const error = Astro.url.searchParams.get("error");
---

<Layout title={m.campaign_new_title()}>
  <main class="mx-auto max-w-xl px-4 pt-16 pb-20">
    <div class="text-center">
      <span class="section-label">{m.campaign_new_section_label()}</span>
      <h1 class="text-ivory font-display mt-1 text-5xl">{m.campaign_new_title()}</h1>
    </div>

    <Ornament class="my-6" />

    <div class="ink-card p-6 md:p-8">
      <CreateCampaignForm serverError={error} client:load />
    </div>

    <p class="mt-4 text-center text-sm">
      <a href="/campaigns" class="text-blood-bright hover:underline">{m.campaign_back()}</a>
    </p>
  </main>
</Layout>
