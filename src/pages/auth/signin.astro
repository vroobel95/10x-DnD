---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import Ornament from "@/components/Ornament.astro";
import { m } from "@/paraglide/messages.js";

const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
---

<Layout title={m.auth_signin_title()}>
  <main class="flex min-h-full items-center justify-center px-4 py-12">
    <div class="ink-card w-full max-w-sm p-8">
      <h1 class="text-ivory font-display text-center text-3xl">{m.auth_signin_title()}</h1>
      <Ornament class="my-5" />
      {
        success && (
          <div class="border-gold/40 bg-gold/10 text-gold mb-4 rounded-md border px-4 py-3 text-sm">
            {m.auth_signin_password_updated()}
          </div>
        )
      }
      <SignInForm serverError={error} client:load />
      <p class="text-ivory-dim mt-4 text-center text-sm">
        {m.auth_signin_no_account()}{" "}
        <a href="/auth/signup" class="text-blood-bright hover:underline">{m.auth_signin_signup_link()}</a>
      </p>
      <p class="text-ivory-dim mt-2 text-center text-sm">
        <a href="/auth/forgot-password" class="text-blood-bright hover:underline">{m.auth_signin_forgot()}</a>
      </p>
    </div>
  </main>
</Layout>
