---
import Layout from "@/layouts/Layout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import { m } from "@/paraglide/messages.js";

if (!Astro.locals.user) {
  return Astro.redirect(`/auth/forgot-password?error=${encodeURIComponent(m.auth_reset_link_invalid())}`);
}

const error = Astro.url.searchParams.get("error");
---

<Layout title={m.auth_reset_title()}>
  <div class="bg-cosmic flex h-full items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-linear-to-r from-blue-200 to-rose-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        {m.auth_reset_title()}
      </h1>
      <ResetPasswordForm serverError={error} client:load />
    </div>
  </div>
</Layout>
