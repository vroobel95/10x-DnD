---
import Layout from "@/layouts/Layout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import Ornament from "@/components/Ornament.astro";
import { m } from "@/paraglide/messages.js";

if (!Astro.locals.user) {
  return Astro.redirect(`/auth/forgot-password?error=${encodeURIComponent(m.auth_reset_link_invalid())}`);
}

const error = Astro.url.searchParams.get("error");
---

<Layout title={m.auth_reset_title()}>
  <main class="flex min-h-full items-center justify-center px-4 py-12">
    <div class="ink-card w-full max-w-sm p-8">
      <h1 class="text-ivory font-display text-center text-3xl">{m.auth_reset_title()}</h1>
      <Ornament class="my-5" />
      <ResetPasswordForm serverError={error} client:load />
    </div>
  </main>
</Layout>
