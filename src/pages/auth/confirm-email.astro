---
import Layout from "@/layouts/Layout.astro";
import Ornament from "@/components/Ornament.astro";
import { m } from "@/paraglide/messages.js";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: m.auth_confirm_success_heading(),
      description: m.auth_confirm_success_desc(),
      linkText: m.auth_confirm_success_link(),
    }
  : {
      emoji: "📧",
      heading: m.auth_confirm_email_heading(),
      description: m.auth_confirm_email_desc(),
      linkText: m.auth_confirm_email_link(),
    };
---

<Layout title={content.heading}>
  <main class="flex min-h-full items-center justify-center px-4 py-12">
    <div class="ink-card w-full max-w-sm p-8 text-center">
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="text-ivory font-display text-3xl">{content.heading}</h1>
      <Ornament class="my-5" />
      <p class="text-ivory-dim mb-6">{content.description}</p>
      <a href="/auth/signin" class="text-blood-bright text-sm hover:underline">
        {content.linkText}
      </a>
    </div>
  </main>
</Layout>
