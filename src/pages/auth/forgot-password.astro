---
import Layout from "@/layouts/Layout.astro";
import ForgotPasswordForm from "@/components/auth/ForgotPasswordForm";
import { m } from "@/paraglide/messages.js";

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
---

<Layout title={m.auth_forgot_title()}>
  <div class="bg-cosmic flex h-full items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      {
        success ? (
          <div class="text-center">
            <div class="mb-4 text-5xl">📧</div>
            <h1 class="mb-3 bg-linear-to-r from-blue-200 to-rose-200 bg-clip-text text-center text-2xl font-bold text-transparent">
              {m.auth_forgot_check_email_title()}
            </h1>
            <p class="mb-6 text-blue-100/80">{m.auth_forgot_check_email_desc()}</p>
            <a href="/auth/signin" class="text-sm text-rose-300 hover:underline">
              {m.auth_back_to_signin()}
            </a>
          </div>
        ) : (
          <>
            <h1 class="mb-6 bg-linear-to-r from-blue-200 to-rose-200 bg-clip-text text-center text-2xl font-bold text-transparent">
              {m.auth_forgot_title()}
            </h1>
            <ForgotPasswordForm serverError={error} client:load />
            <p class="mt-4 text-center text-sm text-blue-100/60">
              <a href="/auth/signin" class="text-rose-300 hover:underline">
                {m.auth_back_to_signin()}
              </a>
            </p>
          </>
        )
      }
    </div>
  </div>
</Layout>
