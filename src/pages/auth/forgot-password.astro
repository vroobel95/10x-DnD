---
import Layout from "@/layouts/Layout.astro";
import ForgotPasswordForm from "@/components/auth/ForgotPasswordForm";
import Ornament from "@/components/Ornament.astro";
import { m } from "@/paraglide/messages.js";

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
---

<Layout title={m.auth_forgot_title()}>
  <main class="flex min-h-full items-center justify-center px-4 py-12">
    <div class="ink-card w-full max-w-sm p-8">
      {
        success ? (
          <div class="text-center">
            <div class="mb-4 text-5xl">📧</div>
            <h1 class="text-ivory font-display text-center text-3xl">{m.auth_forgot_check_email_title()}</h1>
            <Ornament class="my-5" />
            <p class="text-ivory-dim mb-6">{m.auth_forgot_check_email_desc()}</p>
            <a href="/auth/signin" class="text-blood-bright text-sm hover:underline">
              {m.auth_back_to_signin()}
            </a>
          </div>
        ) : (
          <>
            <h1 class="text-ivory font-display text-center text-3xl">{m.auth_forgot_title()}</h1>
            <Ornament class="my-5" />
            <ForgotPasswordForm serverError={error} client:load />
            <p class="text-ivory-dim mt-4 text-center text-sm">
              <a href="/auth/signin" class="text-blood-bright hover:underline">
                {m.auth_back_to_signin()}
              </a>
            </p>
          </>
        )
      }
    </div>
  </main>
</Layout>
