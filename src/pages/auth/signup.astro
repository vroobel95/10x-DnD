---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import Ornament from "@/components/Ornament.astro";
import { m } from "@/paraglide/messages.js";

const error = Astro.url.searchParams.get("error");
---

<Layout title={m.auth_signup_title()}>
  <main class="flex min-h-full items-center justify-center px-4 py-12">
    <div class="ink-card w-full max-w-sm p-8">
      <h1 class="text-ivory font-display text-center text-3xl">{m.auth_signup_title()}</h1>
      <Ornament class="my-5" />
      <SignUpForm serverError={error} client:load />
      <p class="text-ivory-dim mt-4 text-center text-sm">
        {m.auth_signup_have_account()}{" "}
        <a href="/auth/signin" class="text-blood-bright hover:underline">{m.auth_signup_signin_link()}</a>
      </p>
    </div>
  </main>
</Layout>
