---
interface Props {
  label: string;
  version?: string;
}

const { label, version } = Astro.props;
---

<span
  class="bg-ink-soft text-ivory-dim border-border inline-flex items-center gap-2 rounded-lg border px-3 py-1.5 font-mono shadow-sm"
>
  {label}
  {
    version && (
      <span class="bg-blood/20 text-ivory border-blood/40 rounded-full border px-2 py-0.5 text-xs">{version}</span>
    )
  }
</span>
