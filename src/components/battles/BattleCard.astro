---
import type { Battle } from "@/types";

interface Props {
  battle: Battle;
}

const { battle } = Astro.props;

const partyLevel = battle.party_level != null ? `Level ${battle.party_level}` : "—";
const createdDate = new Date(battle.created_at).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a
  href={`/battles/${battle.id}`}
  class="block rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl transition-colors hover:border-purple-400/30 hover:bg-white/10"
>
  <h3 class="mb-2 text-base font-semibold text-white">{battle.name}</h3>
  <div class="flex flex-wrap gap-3 text-sm text-blue-100/60">
    <span>Party {partyLevel}</span>
    <span>·</span>
    <span>{createdDate}</span>
  </div>
</a>
