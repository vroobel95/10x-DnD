---
import { m } from "@/paraglide/messages.js";
import { getLocale } from "@/paraglide/runtime.js";
import type { Battle } from "@/types";

interface Props {
  battle: Battle;
}

const { battle } = Astro.props;

const partyLevel =
  battle.party_level != null ? m.battle_level({ level: battle.party_level }) : m.battle_level_unknown();
const createdDate = new Date(battle.created_at).toLocaleDateString(getLocale(), {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a href={`/battles/${battle.id}`} class="ink-card group block p-5">
  <h3 class="text-ivory font-display group-hover:text-blood-bright mb-1 text-xl transition">{battle.name}</h3>
  <div class="text-ivory-dim flex flex-wrap gap-3 text-sm">
    <span>{m.battle_party({ level: partyLevel })}</span>
    <span class="text-border">·</span>
    <span>{createdDate}</span>
  </div>
</a>
