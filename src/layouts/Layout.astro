---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import Topbar from "@/components/Topbar.astro";
import { missingConfigs } from "@/lib/config-status";
import { m } from "@/paraglide/messages.js";
import { getLocale } from "@/paraglide/runtime.js";

interface Props {
  title?: string;
}

const { title = "DnD 5enemy" } = Astro.props;
---

<!doctype html>
<html lang={getLocale()}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/images/dices.png" />
    <title>{title}</title>
  </head>
  <body class="bg-cosmic flex flex-col overflow-hidden">
    <Topbar />
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>{m.banner_notice()}</strong> {cfg.message()}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel?.() ?? m.banner_docs()}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <main class="flex-1 overflow-y-auto">
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
